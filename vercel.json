{
  "version": 2,
  "buildCommand": "yarn build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/jobs/daily",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}